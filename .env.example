# Todo lo que la aplicacion lee del entorno esta en este fichero. Lo que va comentado tiene un valor
# por defecto en application*.yaml que sirve tal cual. mto-users no tiene base de datos ni broker:
# todo lo que administra vive en el Keycloak de mto-platform.

# Spring application
SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_DEFAULT=dev
SERVER_PORT=8080
# Puerto publicado en el host. 8084: el 8080 es mto-stock, 8081 mto-configuration, 8082 Keycloak,
# 8083 mto-maintenance y 8090 el gateway.
APP_PORT=8084
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# --- Resource server: los tokens que acepta esta API --------------------------------------------
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
# Cliente de Keycloak que representa a esta API; sus roles de cliente son los permisos.
KEYCLOAK_USERS_CLIENT_ID=mto-users-api
KEYCLOAK_AUDIENCE=mto-users-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# --- Admin API: el realm que se administra y la cuenta de servicio ---------------------------------
# Raiz de Keycloak SIN realm; el mismo host que el 'iss' de los tokens.
KEYCLOAK_AUTH_SERVER_URL=http://auth.mto.local:8082
KEYCLOAK_REALM=mto
# Cliente confidencial con cuenta de servicio. Lo crea keycloak/mto-users-partial-import.json; sus
# roles de realm-management (view-users, query-users, manage-users, view-clients, query-clients,
# view-realm) los concede mto-platform/keycloak/apply-partials.sh. El secreto lo fija
# keycloak/mto-users-dev.json en local; en un entorno desplegado lo genera Keycloak y se copia de
# Clients -> mto-users-svc -> Credentials. NUNCA una credencial del realm master.
KEYCLOAK_ADMIN_CLIENT_ID=mto-users-svc
KEYCLOAK_ADMIN_CLIENT_SECRET=mto-users-svc-secret
# Timeouts del cliente HTTP hacia Keycloak.
# KEYCLOAK_CONNECT_TIMEOUT=2s
# KEYCLOAK_READ_TIMEOUT=10s
# KEYCLOAK_POOL_SIZE=10

# --- Perfiles ------------------------------------------------------------------------------------
# Los perfiles son los roles compuestos de realm cuyo nombre empieza por este prefijo.
APP_PROFILES_PREFIX=mto-
# Roles de realm con el prefijo que NO se administran desde aqui (lista separada por comas).
# APP_PROFILES_EXCLUDED=

# --- API -----------------------------------------------------------------------------------------
# Publicar /swagger-ui y /v3/api-docs sin token. Cerrado en produccion.
APP_SECURITY_EXPOSE_API_DOCS=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200
# APP_CORS_MAX_AGE=3600

# --- Actuator y observabilidad ------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
SPRINGDOC_SHOW_ACTUATOR=false
MTO_TRACING_ENABLED=true
MTO_TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces

# --- Logging y JVM -------------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
# SHUTDOWN_TIMEOUT=30s
